# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
payload.db
payload-types.ts
src/payload-types.ts

# local secrets and credentials
client_secrets.json*

# workspace settings and temporary agents
.claude/
scratch/

# large generated video assets
/public/videos/

# render pipeline working directory
/output/

# temp/backup files
*.bak
*.mp4
*.RESTITCHED
__pycache__/
*.pyc

# CRM data — never overwrite production leads on deploy
src/data/leads.json

# Phone-reveal click-intent log — runtime-generated, not source
src/data/phone-reveals.json

# Generated batch data — expensive Azure output, tracked once as backup; new runs stay local
data/batch/

# Onboarding multi-run driver evidence — transcripts + per-turn screenshots,
# regenerated on every run, not source
scripts/onboarding-personas/output/

# Articulation & EQ Trainer — generated engine cache + local session transcripts,
# never source (spec: docs/specs/articulation-trainer.md)
data/trainer/engine.json
data/trainer/sessions/
data/trainer/generated/
data/trainer/probe/
data/trainer/profile.json
data/trainer/memos.jsonl

# trainer test build output
dist/

data/trainer/results/

# Billing engine — local SQLite dev DB; production uses BILLING_DB_PATH inside
# $WAO_RUNTIME_DATA_DIR (persistent, outside the git tree), never this path.
data/billing.db
data/billing.db-wal
data/billing.db-shm

# Inner Coach — entire dir git-ignored (D2 hardening rider, docs/specs/inner-coach-workplan.md
# §2/§8): the Belief Ledger and session transcripts are intimate, Eitan-only, never source.
data/inner-coach/
data/bot-sessions/
data/payments/
data/sites-pending/

# Site-bot chat image uploads — session-scoped runtime user data, never source
/public/uploads/

# Handoff dynamic files (folders stay tracked via .gitkeep)
handoff/pending/*.md
handoff/in-progress/*.md
handoff/completed/*.md
handoff/failed/*.md
handoff/archive/*.md
data/geo-leads/
