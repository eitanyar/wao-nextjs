sks({\\n149|      clientId: sessionClientId,\\n150|      campaign,\\n151|      customerId: index.primaryCustomerId,\\n152|    });\\n153|    const task = tasks.find((item) => item.taskId === taskId);\\n154|\\n155|    if (!task) {\\n156|      return NextResponse.json(\\n157|        { error: 'Task not found or it is stale. Refresh the dashboard and try again.' },\\n158|        { status: 404 }\\n159|      );\\n160|    }\\n161|\\n162|    // windowEnd for the approval record — from this task's own campaign digest when known,\\n163|    // falling back to any digest built this cycle (they share the same 7-day window/`now`).\\n164|    const digestWindowEnd =\\n165|      digestsByCampaignId.get(task.campaignId)?.windowEnd ??\\n166|      digestsByCampaignId.values().next().value?.windowEnd ??\\n167|      new Date().toISOString();\\n168|\\n169|    const existingApproval = readGoogleAdsApprovals(sessionClientId).find((item) => item.taskId === taskId);\\n170|    if (existingApproval) {\\n171|      return NextResponse.json({\\n172|        success: true,\\n173|        task: existingApproval,\\n174|        queued: true,\\n175|        message: 'Task already has a decision on record.',\\n176|      });\\n177|    }\\n178|\\n179|    // Reject: log the decision (resets the trust clock, per interaction-model spec §2.1)\\n180|    // and stop — never enters the execution pipeline below.\\n181|    if (decision === 'reject') {\\n182|      const rejection = buildApprovalRecord(task, sessionClientId, digestWindowEnd, 'rejected', {\\n183|        correctionNote,\\n184|      });\\n185|      appendGoogleAdsApproval(rejection);\\n186|\\n187|      try {\\n188|        await sendGoogleAdsOperatorApprovalEmail({\\n189|          clientId: sessionClientId,\\n190|          title: task.title,\\n191|          recommendedAction: task.recommendedAction,\\n192|          approvedBy: sessionClientId,\\n193|          status: 'rejected',\\n194|          error: correctionNote,\\n195|        });\\n196|      } catch {\